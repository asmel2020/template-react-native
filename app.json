{
  "expo": {
    "name": "template-react-native",
    "slug": "template-react-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "templatereactnative",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.asmel.templatereactnative"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
